{
  "cloudflare": {
    "schema": "sow-edge-runtime/v2",
    "target": "cf",
    "runtime": "cloudflare",
    "variables": {
      "SOW_EDGE_SCHEMA": "sow-edge-runtime/v2",
      "SOW_PRO_PREFIX": "/pro/v1/{token}/",
      "SOW_PUBLIC_BASE_URL": "https://repo.example",
      "SOW_BETA_BASE_URL": "https://beta.example",
      "SOW_TOKEN_VERIFIER": "provider://pigsty-entitlements",
      "SOW_PUBLIC_PREFIXES": "[\"bin\"]",
      "SOW_PUBLIC_KEYS": "[\"keys/test-package-trust.asc\"]",
      "SOW_COMPATIBILITY_ADMISSION": "{\"apt_roots\":[],\"yum_repos\":[],\"yum_roots\":[],\"yum_channels\":[],\"asset_roots\":[\"bin\"],\"asset_keys\":[],\"projections\":[],\"snapshots\":[],\"raw\":[],\"active\":[]}",
      "SOW_ORIGIN_MODE": "r2-service"
    },
    "service_bindings": [
      "ORIGIN",
      "TOKEN_VERIFIER"
    ]
  },
  "edgeone": {
    "schema": "sow-edge-runtime/v2",
    "target": "cos",
    "runtime": "edgeone",
    "variables": {
      "SOW_EDGE_SCHEMA": "sow-edge-runtime/v2",
      "SOW_PRO_PREFIX": "/pro/v1/{token}/",
      "SOW_PUBLIC_BASE_URL": "https://repo-cn.example",
      "SOW_BETA_BASE_URL": "https://beta-cn.example",
      "SOW_TOKEN_VERIFIER": "provider://pigsty-entitlements",
      "SOW_PUBLIC_PREFIXES": "[\"bin\"]",
      "SOW_PUBLIC_KEYS": "[\"keys/test-package-trust.asc\"]",
      "SOW_COMPATIBILITY_ADMISSION": "{\"apt_roots\":[],\"yum_repos\":[],\"yum_roots\":[],\"yum_channels\":[],\"asset_roots\":[\"bin\"],\"asset_keys\":[],\"projections\":[],\"snapshots\":[],\"raw\":[],\"active\":[]}",
      "SOW_ORIGIN_MODE": "cos-sigv4",
      "SOW_COS_REGION": "ap-shanghai",
      "SOW_COS_BUCKET": "repo-cos-1250000000"
    },
    "required_variables": [
      "SOW_TOKEN_VERIFIER_URL"
    ],
    "required_secrets": [
      "SOW_COS_SECRET_ID",
      "SOW_COS_SECRET_KEY",
      "SOW_TOKEN_VERIFIER_BEARER"
    ]
  }
}
